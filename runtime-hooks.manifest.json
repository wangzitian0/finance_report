{
  "schema_version": 3,
  "service": "finance_report/app",
  "checks": [
    {
      "id": "smoke",
      "argv": [
        "sh",
        "-c",
        "bash common/runtime/shell/smoke_test.sh \"$APP_URL\""
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 120,
      "cells": {
        "add": {
          "prod.post": {
            "reason": "prod gate runs smoke as before",
            "issue": "wangzitian0/infra2#1823"
          }
        }
      }
    },
    {
      "id": "preview_minimum_e2e",
      "argv": [
        "python",
        "-m",
        "common.testing.test_selection",
        "--stage",
        "preview_minimum_e2e",
        "--run"
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": true,
      "accepts_scale": false,
      "timeout_seconds": 240,
      "bootstrap": "uv pip install --system -r tests/e2e/requirements.txt && playwright install chromium",
      "cells": {
        "remove": {
          "staging.post": {
            "reason": "preview-only check",
            "issue": "wangzitian0/infra2#1823"
          },
          "scheduled_audit": {
            "reason": "preview-only check",
            "issue": "wangzitian0/infra2#1823"
          }
