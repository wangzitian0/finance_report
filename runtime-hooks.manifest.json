{
  "schema_version": 2,
  "service": "finance_report/app",
  "slots": {
    "smoke": {
      "run": "bash common/runtime/shell/smoke_test.sh \"$INFRA2_HOOK_APP_URL\"",
      "timeout_seconds": 120
    },
    "preview_gate": {
      "bootstrap": "uv pip install --system -r tests/e2e/requirements.txt && playwright install chromium",
      "checks": [
        {"id": "smoke", "argv": ["sh", "-c", "bash common/runtime/shell/smoke_test.sh \"$INFRA2_HOOK_APP_URL\""]},
        {"id": "preview_minimum_e2e", "argv": ["python", "-m", "common.testing.test_selection", "--stage", "preview_minimum_e2e", "--run"]},
        {"id": "touched_files", "argv": ["sh", "-c", "python -m common.testing.test_selection --touched-files ${INFRA2_TOUCHED_FILES:-} --run"]}
      ],
      "timeout_seconds": 360,
      "optional_env": [
        "AI_PROVIDER",
        "AI_BASE_URL",
        "LARGE_MODEL",
        "SMALL_MODEL",
        "MULTIMODAL_MODEL"
      ]
    },
    "staging_gate": {
      "bootstrap": "uv pip install --system -r tests/e2e/requirements.txt && playwright install chromium",
      "checks": [
        {"id": "smoke", "argv": ["sh", "-c", "bash common/runtime/shell/smoke_test.sh \"$INFRA2_HOOK_APP_URL\""]},
        {"id": "staging_core_e2e", "argv": ["python", "-m", "common.testing.test_selection", "--stage", "staging_core_e2e", "--run"]},
        {"id": "ai_provider_connectivity", "argv": ["env", "STRICT_E2E_GATES=1", "python", "-m", "pytest", "tests/e2e/test_ai_provider_connectivity.py", "-v", "--tb=short", "-o", "addopts="]},
        {"id": "staging_ai_ocr", "argv": ["python", "-m", "common.testing.test_selection", "--stage", "staging_ai_ocr", "--corpus", "canary", "--run"]}
      ],
      "timeout_seconds": 540,
      "optional_env": [
        "AI_PROVIDER",
        "AI_BASE_URL",
        "LARGE_MODEL",
        "SMALL_MODEL",
        "MULTIMODAL_MODEL",
        "TEST_USER_EMAIL",
        "TEST_USER_PASSWORD"
      ]
    },
    "prod_gate": {
      "run": "bash common/runtime/shell/smoke_test.sh \"$INFRA2_HOOK_APP_URL\"",
      "timeout_seconds": 180
    },
    "scheduled_audit": {
      "bootstrap": "uv pip install --system -r tests/e2e/requirements.txt && playwright install chromium",
      "checks": [
        {"id": "audit_replay", "argv": ["python", "-m", "common.testing.test_selection", "--stage", "staging_ai_ocr", "--corpus", "audit_replay", "--run"]},
        {"id": "core_journey", "argv": ["python", "-m", "common.testing.test_selection", "--stage", "staging_ai_ocr", "--corpus", "core_journey", "--run"]},
        {"id": "pdf_corpus_oracle", "argv": ["sh", "-c", "python -m common.testing.benchmarks.pdf_corpus_oracle --app-url \"$INFRA2_HOOK_APP_URL\" --max-workers 1"]},
        {"id": "financial_scenario_benchmark", "argv": ["sh", "-c", "python -m common.testing.benchmarks.run_financial_scenario_benchmark --app-url \"$INFRA2_HOOK_APP_URL\" --case 1,2,3,4,5,6"]}
      ],
      "timeout_seconds": 3600,
      "optional_env": [
        "AI_PROVIDER",
        "AI_BASE_URL",
        "LARGE_MODEL",
        "SMALL_MODEL",
        "MULTIMODAL_MODEL",
        "TEST_USER_EMAIL",
        "TEST_USER_PASSWORD"
      ]
    }
  }
}
